<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.service.ytlounge-cast"
       name="YouTube Lounge Cast Receiver"
       version="2.0.5"
       provider-name="luimu">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="inputstream.adaptive" minversion="20.0.0" optional="true"/>
    </requires>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.python.pluginsource" library="plugin.py">
        <provides>audio</provides>
    </extension>
    <extension point="xbmc.python.script" library="actions.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Cast YouTube from your phone to Kodi using TV code pairing</summary>
        <description lang="en_GB">Background service emulating YouTube on TV (Lounge API). Pair from the YouTube mobile app with a TV code, then stream and control videos with yt-dlp playback directly in Kodi.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
