msgctxt "#30000"
msgid "General"
msgstr "General"

msgctxt "#30001"
msgid "Enable YouTube Lounge Cast Receiver"
msgstr "Enable YouTube Lounge Cast Receiver"

msgctxt "#30002"
msgid "Screen Name (visible in YouTube app)"
msgstr "Screen Name (visible in YouTube app)"

msgctxt "#30003"
msgid "Show pairing code on startup"
msgstr "Show pairing code on startup"

msgctxt "#30038"
msgid "Manual linking only. By default devices link via Wi-Fi discovery; use the 'Show pairing code' button to link manually"
msgstr "Manual linking only. By default devices link via Wi-Fi discovery; use the 'Show pairing code' button to link manually"

msgctxt "#30004"
msgid "Enable debug logging"
msgstr "Enable debug logging"

msgctxt "#30030"
msgid "Enable Wi-Fi Network Discovery (SSDP/DIAL)"
msgstr "Enable Wi-Fi Network Discovery (SSDP/DIAL)"

msgctxt "#30031"
msgid "Allows YouTube and YouTube Music to automatically find Kodi on the local Wi-Fi network"
msgstr "Allows YouTube and YouTube Music to automatically find Kodi on the local Wi-Fi network"

msgctxt "#30032"
msgid "DIAL Discovery Port"
msgstr "DIAL Discovery Port"

msgctxt "#30033"
msgid "HTTP port for DIAL device description and pairing (default: 8008)"
msgstr "HTTP port for DIAL device description and pairing (default: 8008)"

msgctxt "#30010"
msgid "Playback"
msgstr "Playback"

msgctxt "#30015"
msgid "Stream Selection Mode"
msgstr "Stream Selection Mode"

msgctxt "#30016"
msgid "Controls whether Kodi allows manual stream/resolution picking in the OSD menu or auto-adapts"
msgstr "Controls whether Kodi allows manual stream/resolution picking in the OSD menu or auto-adapts"

msgctxt "#30017"
msgid "Manual OSD (choose resolution in player menu)"
msgstr "Manual OSD (choose resolution in player menu)"

msgctxt "#30018"
msgid "Adaptive (auto bitrate / bandwidth)"
msgstr "Adaptive (auto bitrate / bandwidth)"

msgctxt "#30019"
msgid "Ask quality on playback start"
msgstr "Ask quality on playback start"

msgctxt "#30022"
msgid "Maximum Resolution Limit"
msgstr "Maximum Resolution Limit"

msgctxt "#30023"
msgid "Capped maximum resolution exposed to Kodi player"
msgstr "Capped maximum resolution exposed to Kodi player"

msgctxt "#30024"
msgid "Auto / Unlimited"
msgstr "Auto / Unlimited"

msgctxt "#30025"
msgid "4K (2160p)"
msgstr "4K (2160p)"

msgctxt "#30026"
msgid "2K (1440p)"
msgstr "2K (1440p)"

msgctxt "#30027"
msgid "1080p Full HD"
msgstr "1080p Full HD"

msgctxt "#30028"
msgid "720p HD"
msgstr "720p HD"

msgctxt "#30029"
msgid "480p SD"
msgstr "480p SD"

msgctxt "#30013"
msgid "Update yt-dlp binary now"
msgstr "Update yt-dlp binary now"

msgctxt "#30014"
msgid "Download the latest release of yt-dlp matching your hardware architecture"
msgstr "Download the latest release of yt-dlp matching your hardware architecture"

msgctxt "#30011"
msgid "Custom yt-dlp binary path (leave empty for auto)"
msgstr "Custom yt-dlp binary path (leave empty for auto)"

msgctxt "#30012"
msgid "Cookies file path (optional)"
msgstr "Cookies file path (optional)"

msgctxt "#30020"
msgid "Advanced"
msgstr "Advanced"

msgctxt "#30021"
msgid "Persisted session tokens (JSON)"
msgstr "Persisted session tokens (JSON)"

msgctxt "#30034"
msgid "Link with TV code now (Show pairing code)"
msgstr "Link with TV code now (Show pairing code)"

msgctxt "#30035"
msgid "Display the 12-digit TV pairing code to link the YouTube mobile app"
msgstr "Display the 12-digit TV pairing code to link the YouTube mobile app"

msgctxt "#30036"
msgid "Reset & re-link with a fresh TV code"
msgstr "Reset & re-link with a fresh TV code"

msgctxt "#30037"
msgid "Clear existing device registrations and generate a brand-new pairing code"
msgstr "Clear existing device registrations and generate a brand-new pairing code"

msgctxt "#30039"
msgid "Music visualizer (audio-only mode)"
msgstr "Music visualizer (audio-only mode)"

msgctxt "#30040"
msgid "Play as audio-only so Kodi shows its music visualizer. Auto = only for songs with no real video (static album art)"
msgstr "Play as audio-only so Kodi shows its music visualizer. Auto = only for songs with no real video (static album art)"

msgctxt "#30041"
msgid "Auto (static art songs only)"
msgstr "Auto (static art songs only)"

msgctxt "#30042"
msgid "Always (all music)"
msgstr "Always (all music)"

msgctxt "#30043"
msgid "Never"
msgstr "Never"

msgctxt "#30044"
msgid "Normalize loudness of casts"
msgstr "Normalize loudness of casts"

msgctxt "#30045"
msgid "Match every cast to the same loudness so quiet and loud videos stop jumping. The audio track is re-rendered in the background (needs ffmpeg, downloaded once); a track plays with its original audio until its render is ready"
msgstr "Match every cast to the same loudness so quiet and loud videos stop jumping. The audio track is re-rendered in the background (needs ffmpeg, downloaded once); a track plays with its original audio until its render is ready"

msgctxt "#30046"
msgid "Target loudness (LUFS)"
msgstr "Target loudness (LUFS)"

msgctxt "#30047"
msgid "Integrated loudness every cast is matched to. -14 LUFS is the YouTube/Spotify streaming level; lower numbers are quieter"
msgstr "Integrated loudness every cast is matched to. -14 LUFS is the YouTube/Spotify streaming level; lower numbers are quieter"

msgctxt "#30048"
msgid "Maximum boost (dB)"
msgstr "Maximum boost (dB)"

msgctxt "#30049"
msgid "Cap on how far a quiet track is raised, so noise floors and near-silence are not amplified into hiss. Cuts are always applied in full"
msgstr "Cap on how far a quiet track is raised, so noise floors and near-silence are not amplified into hiss. Cuts are always applied in full"

msgctxt "#30050"
msgid "Skip items longer than (minutes)"
msgstr "Skip items longer than (minutes)"

msgctxt "#30051"
msgid "Rendering costs roughly real-time/7 on a Pi 4, so very long items are played unnormalized"
msgstr "Rendering costs roughly real-time/7 on a Pi 4, so very long items are played unnormalized"

msgctxt "#30052"
msgid "Download ffmpeg now (audio normalization)"
msgstr "Download ffmpeg now (audio normalization)"

msgctxt "#30053"
msgid "Fetch the static ffmpeg build used for loudness measurement and re-encoding (~120 MB, one time)"
msgstr "Fetch the static ffmpeg build used for loudness measurement and re-encoding (~120 MB, one time)"

msgctxt "#30054"
msgid "Custom ffmpeg path"
msgstr "Custom ffmpeg path"

msgctxt "#30055"
msgid "Leave empty to use the binary downloaded into the addon profile. Set this to use an ffmpeg already on the device"
msgstr "Leave empty to use the binary downloaded into the addon profile. Set this to use an ffmpeg already on the device"

msgctxt "#30056"
msgid "Playback quality mode"
msgstr "Playback quality mode"

msgctxt "#30057"
msgid "Auto starts every cast on the lowest quality and upgrades to the best available in the background, so playback begins within about a second. Adaptive lets the player pick quality from the measured bandwidth. Manual leaves the choice to you in the player's quality menu"
msgstr "Auto starts every cast on the lowest quality and upgrades to the best available in the background, so playback begins within about a second. Adaptive lets the player pick quality from the measured bandwidth. Manual leaves the choice to you in the player's quality menu"

msgctxt "#30058"
msgid "Auto (start low, upgrade invisibly)"
msgstr "Auto (start low, upgrade invisibly)"

msgctxt "#30059"
msgid "Adaptive (player picks from bandwidth)"
msgstr "Adaptive (player picks from bandwidth)"

msgctxt "#30060"
msgid "Manual (choose from player quality menu)"
msgstr "Manual (choose from player quality menu)"
